<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <SurfaceView
        android:id="@+id/game_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Touch Control overlay: hosts dynamic touch joysticks and buttons, and Edit mode UI. -->
    <com.skarm.launcher.touch.TouchControlOverlay
        android:id="@+id/touch_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Chrome buttons. Positioned programmatically (GameActivity.applyChromePositions)
         and draggable to reposition while Edit Layout mode is active, so the gear can be
         moved off SK's "My Auctions" button. Exit is handled by Android Back. -->
    <!-- Chrome row: three equal squares. Positioned programmatically
         (GameActivity.applyChromePositions) and draggable in Edit Layout mode. -->
    <ImageButton
        android:id="@+id/btn_edit_layout"
        android:layout_width="@dimen/chrome_button_size"
        android:layout_height="@dimen/chrome_button_size"
        android:layout_gravity="top|start"
        android:background="@drawable/bg_chrome_button"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_settings"
        android:alpha="0.55"
        android:contentDescription="@string/chrome_edit_layout" />

    <ImageButton
        android:id="@+id/btn_keyboard"
        android:layout_width="@dimen/chrome_button_size"
        android:layout_height="@dimen/chrome_button_size"
        android:layout_gravity="top|start"
        android:background="@drawable/bg_chrome_button"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_keyboard"
        android:alpha="0.55"
        android:contentDescription="@string/keyboard" />

    <ImageButton
        android:id="@+id/btn_toggle_buttons"
        android:layout_width="@dimen/chrome_button_size"
        android:layout_height="@dimen/chrome_button_size"
        android:layout_gravity="top|start"
        android:background="@drawable/bg_chrome_button"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_eye"
        android:alpha="0.55"
        android:contentDescription="@string/chrome_toggle_buttons" />

    <!-- Invisible focusable view that hosts the soft-keyboard InputConnection and
         forwards typed input to SK (the SurfaceView can't host an IME). -->
    <com.skarm.launcher.ImeBridgeView
        android:id="@+id/ime_bridge"
        android:layout_width="1dp"
        android:layout_height="1dp" />

    <!-- Boot overlay: covers the otherwise-black gap between this Activity opening
         and SK rendering its first frame. Driven by NativeBridge.onLaunchStatus
         (JVM boot, getdown update, Steam auth) and dismissed on first frame.
         Drawn last so it sits on top of the SurfaceView. -->
    <LinearLayout
        android:id="@+id/boot_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:gravity="center"
        android:orientation="vertical">

        <ProgressBar
            android:id="@+id/boot_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/boot_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/boot_starting"
            android:textColor="@android:color/white"
            android:textSize="16sp" />

    </LinearLayout>

</FrameLayout>

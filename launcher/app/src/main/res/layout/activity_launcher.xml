<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:context=".LauncherActivity">

    <!-- Main Content Area -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="32dp">

        <!-- Top Options/Gear Button -->
        <ImageButton
            android:id="@+id/btn_options"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Options"
            android:src="@drawable/ic_settings"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:tint="#FFFFFF" />

        <!-- Update notification banner -->
        <LinearLayout
            android:id="@+id/update_banner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_update_banner"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_options">

            <ImageView
                android:id="@+id/update_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_download"
                app:tint="#ab4a81"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/update_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/update_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap to view release"
                    android:textColor="#808080"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Title & Subtitle Container -->
        <LinearLayout
            android:id="@+id/title_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/mode_toggle_group"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_chainStyle="packed">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SKapsule"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/subtitle_android"
                android:textColor="#A0A0A0"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Segmented Control (Pill-shaped slider equivalent) -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/mode_toggle_group"
            android:layout_width="240dp"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:checkedButton="@id/btn_mode_web"
            app:layout_constraintTop_toBottomOf="@id/title_container"
            app:layout_constraintBottom_toTopOf="@id/btn_launch"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mode_web"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/mode_web"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                app:strokeColor="#333333"
                app:strokeWidth="1dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.LeftRounded" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mode_steam"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/mode_steam"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                app:strokeColor="#333333"
                app:strokeWidth="1dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.RightRounded" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Launch Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_launch"
            android:layout_width="240dp"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:text="@string/launch"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:backgroundTint="#ab4a81"
            app:cornerRadius="26dp"
            app:icon="@android:drawable/ic_media_play"
            app:iconGravity="textStart"
            app:iconTint="#FFFFFF"
            app:layout_constraintTop_toBottomOf="@id/mode_toggle_group"
            app:layout_constraintBottom_toTopOf="@id/setupGroup"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Setup Status Group -->
        <LinearLayout
            android:id="@+id/setupGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="24dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/btn_launch"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ProgressBar
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:indeterminate="true"
                android:indeterminateTint="#ab4a81"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/setupStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:text="@string/setup_starting" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Sidebar / Navigation Drawer -->
    <ScrollView
        android:id="@+id/sidebar"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#141414"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:id="@+id/sidebar_content_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Sidebar Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="24dp" />

            <!-- Share Logs Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/sidebar_btn_share_logs"
                style="@style/Widget.Material3.Button.TextButton.Icon"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="start|center_vertical"
                android:text="@string/sidebar_share_logs"
                android:textColor="#FFFFFF"
                app:icon="@drawable/ic_share"
                app:iconTint="#FFFFFF"
                app:iconSize="20dp"
                app:iconPadding="12dp" />

            <!-- Download Modpack Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/sidebar_btn_download_mods"
                style="@style/Widget.Material3.Button.TextButton.Icon"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="start|center_vertical"
                android:text="@string/sidebar_download_mods"
                android:textColor="#FFFFFF"
                app:icon="@drawable/ic_download"
                app:iconTint="#FFFFFF"
                app:iconSize="20dp"
                app:iconPadding="12dp" />

            <!-- Apply Mods Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/sidebar_btn_apply_mods"
                style="@style/Widget.Material3.Button.TextButton.Icon"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="start|center_vertical"
                android:text="@string/sidebar_apply_mods"
                android:textColor="#FFFFFF"
                app:icon="@drawable/ic_build"
                app:iconTint="#FFFFFF"
                app:iconSize="20dp"
                app:iconPadding="12dp" />

            <!-- Remove Mods Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/sidebar_btn_remove_mods"
                style="@style/Widget.Material3.Button.TextButton.Icon"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="start|center_vertical"
                android:text="@string/sidebar_remove_mods"
                android:textColor="#FFFFFF"
                app:icon="@drawable/ic_delete"
                app:iconTint="#FFFFFF"
                app:iconSize="20dp"
                app:iconPadding="12dp" />

            <!-- Open Folder Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/sidebar_btn_open_folder"
                style="@style/Widget.Material3.Button.TextButton.Icon"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="start|center_vertical"
                android:text="@string/sidebar_open_folder"
                android:textColor="#FFFFFF"
                app:icon="@drawable/ic_folder"
                app:iconTint="#FFFFFF"
                app:iconSize="20dp"
                app:iconPadding="12dp" />

            <!-- GitHub Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/sidebar_btn_github"
                style="@style/Widget.Material3.Button.TextButton.Icon"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="start|center_vertical"
                android:text="@string/sidebar_github"
                android:textColor="#FFFFFF"
                app:icon="@drawable/ic_github"
                app:iconTint="#FFFFFF"
                app:iconSize="20dp"
                app:iconPadding="12dp" />

            <!-- Discord Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/sidebar_btn_discord"
                style="@style/Widget.Material3.Button.TextButton.Icon"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="start|center_vertical"
                android:text="@string/sidebar_discord"
                android:textColor="#FFFFFF"
                app:icon="@drawable/ic_discord"
                app:iconTint="#FFFFFF"
                app:iconSize="20dp"
                app:iconPadding="12dp" />

            <View
                android:id="@+id/sidebar_divider_logout"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#333333"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />

            <!-- Logout Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/sidebar_btn_logout"
                style="@style/Widget.Material3.Button.TextButton.Icon"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="start|center_vertical"
                android:text="@string/sidebar_logout"
                android:textColor="#FF4D4D"
                app:icon="@drawable/ic_logout"
                app:iconTint="#FF4D4D"
                app:iconSize="20dp"
                app:iconPadding="12dp"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#333333"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp" />

            <!-- Java heap cap -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="@string/pref_max_ram"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_ram_minus"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="34dp"
                    android:layout_height="30dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="@string/ram_decrease"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/text_ram_value"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    tools:text="768 MB" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_ram_plus"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="34dp"
                    android:layout_height="30dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="@string/ram_increase"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_ram_free"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="8dp"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                tools:text="2901 MB free of 7681 MB" />
            <!-- Avoid Screen Edges Option -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/pref_avoid_edges"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_avoid_edges"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Crash Reporting Option -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/pref_crash_reporting"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_crash_reporting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="8dp"
                android:text="@string/pref_crash_reporting_note"
                android:textColor="#AAAAAA"
                android:textSize="12sp" />


        </LinearLayout>
    </ScrollView>

</androidx.drawerlayout.widget.DrawerLayout>

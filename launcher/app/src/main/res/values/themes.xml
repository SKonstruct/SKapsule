<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.SKLauncher" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="27">shortEdges</item>
        <item name="colorPrimary">@color/sk_pink</item>
        <item name="colorSecondary">@color/sk_pink</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <!-- Dark backgrounds and text for a premium game launcher vibe -->
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="ShapeAppearanceOverlay.LeftRounded" parent="">
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeBottomLeft">24dp</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.RightRounded" parent="">
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomRight">24dp</item>
    </style>

    <!-- The Steam sign-in dialogs in the brand's dark surface, whatever the system theme: elevated surface,
         white and secondary text, and pinkText for the buttons and the focused field. -->
    <style name="ThemeOverlay.SKapsule.SignIn" parent="">
        <item name="colorSurfaceContainerHigh">@color/brand_surface_elevated</item>
        <item name="colorSurface">@color/brand_surface_elevated</item>
        <item name="colorOnSurface">@color/brand_text</item>
        <item name="colorOnSurfaceVariant">@color/brand_text_secondary</item>
        <item name="colorPrimary">@color/brand_pink_text</item>
        <item name="colorControlActivated">@color/brand_pink_text</item>
        <item name="colorControlNormal">@color/brand_text_secondary</item>
        <item name="android:textColorPrimary">@color/brand_text</item>
        <item name="android:textColorSecondary">@color/brand_text_secondary</item>
        <item name="android:textColorHint">@color/brand_text_secondary</item>
    </style>
</resources>
